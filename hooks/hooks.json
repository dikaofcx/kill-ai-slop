{
  "description": "Run the killslop linter on every file Claude writes or edits and return findings to Claude.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/cli/index.mjs\" hook"
          }
        ]
      }
    ]
  }
}
